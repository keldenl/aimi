---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SearchContent from "../../components/SearchContent.astro";
import { useT } from "../../lib/i18n";

const locale = Astro.currentLocale ?? "en";
const t = useT(locale);
---

<BaseLayout title={t("search.title")} description={t("search.description")}>
  <SearchContent />
</BaseLayout>

<link rel="stylesheet" href={`${import.meta.env.BASE_URL}pagefind/pagefind-component-ui.css`} />
<script is:inline src={`${import.meta.env.BASE_URL}pagefind/pagefind-component-ui.js`} type="module"></script>
<script is:inline>
  window.addEventListener("DOMContentLoaded", () => {
    if (customElements.get("pagefind-searchbox")) {
      document.querySelector("#search-fallback")?.remove();
    }
  });
</script>
