---
import "../styles/global.css";
import { CircleUser, Disc3, Grid3x3, Library, Music2, Search } from "@lucide/astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Songs, stories, and lyric notes from aimi." } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={`${base}favicon.svg`} />
  </head>
  <body>
    <div class="min-h-screen border-x border-white/5 bg-[#0d1015]/88 shadow-[0_0_80px_rgba(0,0,0,0.42)] backdrop-blur-sm lg:mx-3 lg:my-3 lg:min-h-[calc(100vh-1.5rem)] lg:rounded-2xl lg:border">
      <header class="sticky top-0 z-20 border-b border-white/8 bg-[#101318]/86 backdrop-blur-xl">
        <nav class="mx-auto flex h-18 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-10" aria-label="Primary navigation">
          <a href={base} class="flex min-w-0 items-center gap-3 no-underline">
            <span class="grid size-10 place-items-center rounded-full text-peach" aria-hidden="true">
              <svg viewBox="0 0 42 42" class="size-9">
                <path d="M4 27c4-18 7-18 10 0 3-28 6-28 9 0 3-21 6-21 9 0 2-13 5-13 6 0" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="truncate text-base font-semibold text-peach-strong">aimi music</span>
          </a>

          <div class="hidden items-center gap-8 text-sm text-muted md:flex">
            <a href={base} class="inline-flex items-center gap-2 no-underline transition hover:text-ink">
              <Music2 size={18} />
              Discover
            </a>
            <a href={`${base}songs/nightlight/`} class="inline-flex items-center gap-2 font-semibold text-ink no-underline">
              <Disc3 size={18} class="text-peach" />
              Songs
            </a>
            <a href={`${base}stories/`} class="inline-flex items-center gap-2 no-underline transition hover:text-ink">
              <Library size={18} />
              Stories
            </a>
            <a href={`${base}search/`} class="inline-flex items-center gap-2 no-underline transition hover:text-ink">
              <Search size={20} />
              Search
            </a>
          </div>

          <div class="flex items-center gap-2 text-muted">
            <a href={`${base}search/`} class="grid size-10 place-items-center rounded-full transition hover:bg-white/8 hover:text-ink md:hidden" aria-label="Search">
              <Search size={19} />
            </a>
            <button class="hidden size-10 place-items-center rounded-full transition hover:bg-white/8 hover:text-ink sm:grid" aria-label="Open menu">
              <Grid3x3 size={18} />
            </button>
            <button class="inline-flex h-10 items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 text-sm font-semibold text-ink shadow-inner shadow-white/5 transition hover:bg-white/9" type="button">
              <CircleUser size={22} />
              <span class="hidden sm:inline">Login</span>
            </button>
          </div>
        </nav>
      </header>

      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
