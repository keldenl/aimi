---
import { useT } from "../lib/i18n";

const locale = Astro.currentLocale ?? "en";
const t = useT(locale);
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-10 lg:py-12">
  <p class="mb-3 text-xs font-semibold uppercase tracking-[0.12em] text-peach">{t("search.eyebrow")}</p>
  <h1 class="text-4xl font-bold tracking-normal sm:text-5xl">{t("search.heading")}</h1>
  <div class="mt-8 rounded-lg border border-white/10 bg-white/[0.045] p-4 sm:p-6">
    <pagefind-config base-url={base} bundle-path={`${base}pagefind/`}></pagefind-config>
    <pagefind-searchbox placeholder={t("search.placeholder")} show-sub-results></pagefind-searchbox>
    <p id="search-fallback" class="text-sm leading-6 text-muted">{t("search.fallback")}</p>
  </div>
</section>
