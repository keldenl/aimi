---
import { BookOpen, CirclePlus, Ellipsis, Play, Share2, Tag, Users, Smile, X } from "@lucide/astro";
import TagList from "./TagList.astro";

interface LyricLine {
  id: string;
  text: string;
  annotationId?: string;
  highlighted?: boolean;
}

interface Song {
  slug: string;
  title: string;
  artist: string;
  album: string;
  releaseDate: string;
  duration: string;
  genre: string;
  coverImage: string;
  story: {
    title: string;
    body: string;
  };
  lyrics: Array<{
    label: string;
    lines: LyricLine[];
  }>;
  annotations: Record<string, { lyric: string; body: string }>;
  themes: string[];
  moods: string[];
  credits: string[];
  relatedSongs: Array<{ title: string; slug: string; album: string }>;
}

const { song } = Astro.props as { song: Song };
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const coverSrc = `${base}${song.coverImage.replace(/^\//, "")}`;
const firstAnnotation = Object.values(song.annotations)[0];
---

<article class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-10 lg:px-10" data-pagefind-body>
  <section class="grid gap-6 sm:grid-cols-[13.5rem_minmax(0,1fr)] sm:items-center">
    <img src={coverSrc} alt={`${song.title} cover art`} class="aspect-square w-full max-w-56 rounded-lg border border-white/10 object-cover shadow-2xl shadow-black/40 sm:max-w-none" />

    <div class="min-w-0">
      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.12em] text-muted">Song</p>
      <h1 class="text-4xl font-bold tracking-normal text-ink sm:text-5xl" data-pagefind-meta="title">{song.title}</h1>
      <div class="mt-3 flex items-center gap-2 text-2xl font-semibold">
        <span>{song.artist}</span>
      </div>
      <p class="mt-4 text-sm leading-6 text-muted">
        From the album <span class="font-semibold uppercase tracking-[0.08em] text-peach-strong">{song.album}</span>
      </p>
      <p class="text-sm leading-6 text-muted">{song.releaseDate} <span aria-hidden="true">•</span> {song.duration} <span aria-hidden="true">•</span> {song.genre}</p>

      <div class="mt-5 flex flex-wrap gap-3">
        <a href="#lyrics" class="inline-flex h-11 items-center gap-2 rounded-lg bg-peach px-5 text-sm font-bold text-[#251211] no-underline shadow-lg shadow-peach/10 transition hover:bg-peach-strong">
          <Play size={17} fill="currentColor" />
          Play
        </a>
        <button type="button" class="inline-flex h-11 items-center gap-2 rounded-lg border border-white/12 bg-white/5 px-4 text-sm font-semibold text-ink transition hover:bg-white/9">
          <CirclePlus size={18} />
          Add to library
        </button>
        <button type="button" class="inline-flex h-11 items-center gap-2 rounded-lg border border-white/12 bg-white/5 px-4 text-sm font-semibold text-ink transition hover:bg-white/9">
          <Share2 size={18} />
          Share
        </button>
        <button type="button" class="grid size-11 place-items-center rounded-lg border border-white/12 bg-white/5 text-ink transition hover:bg-white/9" aria-label="More actions">
          <Ellipsis size={20} />
        </button>
      </div>
    </div>
  </section>

  <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_24rem] xl:grid-cols-[minmax(0,1fr)_27rem]">
    <div class="min-w-0">
      <section id="lyrics" class="mt-8 max-w-4xl scroll-mt-28" aria-label={`${song.title} lyrics`}>
        {song.lyrics.map((section) => (
          <div class="mb-6">
            <h2 class="mb-2 text-xs font-semibold uppercase tracking-[0.12em] text-muted">{section.label}</h2>
            <div class="space-y-1 text-[1.04rem] leading-7 text-ink">
              {section.lines.map((line) => {
                const annotation = line.annotationId ? song.annotations[line.annotationId] : undefined;
                return (
                  <button
                    type="button"
                    class:list={[
                      "block w-full rounded-md px-0 py-0.5 text-left transition",
                      annotation ? "cursor-pointer text-ink underline decoration-peach/55 decoration-1 underline-offset-4 hover:bg-peach/10 focus-visible:bg-peach/10 focus-visible:outline focus-visible:outline-1 focus-visible:outline-peach/45" : "cursor-default text-ink/42",
                      line.highlighted ? "text-ink" : "",
                    ]}
                    disabled={!annotation}
                    data-annotation-lyric={annotation?.lyric}
                    data-annotation-body={annotation?.body}
                    onmouseenter={annotation ? "window.setLyricMeaningFromLine?.(this)" : undefined}
                    onfocus={annotation ? "window.setLyricMeaningFromLine?.(this)" : undefined}
                    onclick={annotation ? "window.setLyricMeaningFromLine?.(this)" : undefined}
                  >
                    <span>{line.text}</span>
                  </button>
                );
              })}
            </div>
          </div>
        ))}

        <button type="button" class="mt-1 inline-flex h-10 items-center rounded-lg border border-white/12 bg-white/5 px-3 text-sm text-ink transition hover:bg-white/9">
          Show more
        </button>
      </section>
    </div>

    <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
      <section class="rounded-lg border border-white/10 bg-white/[0.045] p-5 shadow-[inset_0_1px_0_rgba(255,255,255,0.05)]">
        <div class="mb-4 flex items-center justify-between gap-4">
          <h2 class="text-lg font-semibold">{song.story.title}</h2>
          <BookOpen size={21} class="text-ink/80" />
        </div>
        <p class="max-h-28 overflow-hidden text-sm leading-6 text-ink/78">{song.story.body}</p>
        <button type="button" class="mt-5 inline-flex h-10 items-center rounded-lg border border-white/12 bg-white/5 px-3 text-sm text-ink transition hover:bg-white/9" onclick="document.querySelector('[data-story-dialog]')?.showModal()">
          Read full story
        </button>
      </section>

      {firstAnnotation && (
        <section class="rounded-lg border border-peach/20 bg-white/[0.045] p-5 shadow-[inset_0_1px_0_rgba(255,255,255,0.05)]" aria-live="polite">
          <p class="mb-2 text-xs font-semibold uppercase tracking-[0.12em] text-muted">Lyric Meaning</p>
          <p class="mb-4 whitespace-pre-line text-sm font-semibold leading-6 text-peach-strong" data-meaning-lyric>{firstAnnotation.lyric}</p>
          <p class="text-sm leading-6 text-ink/78" data-meaning-body>{firstAnnotation.body}</p>
        </section>
      )}
    </aside>
  </div>

  <div class="mt-6 grid gap-4 lg:grid-cols-[1fr_1fr_24rem] xl:grid-cols-[1fr_1fr_27rem]">
    <TagList title="Themes" items={song.themes} icon={Tag} />
    <TagList title="Moods" items={song.moods} icon={Smile} />
    <section class="rounded-lg border border-white/10 bg-white/[0.045] p-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.05)] sm:p-5">
      <h2 class="mb-3 flex items-center gap-2 text-base font-semibold">
        <Users size={20} />
        Credits
      </h2>
      <ul class="space-y-1 text-sm leading-5 text-ink/78">
        {song.credits.map((credit) => <li>{credit}</li>)}
      </ul>
    </section>
  </div>

  <section class="mt-10 border-t border-white/9 pt-6">
    <div class="mb-4 flex items-center justify-between gap-4">
      <h2 class="text-lg font-semibold">More from aimi</h2>
      <a href={base} class="text-sm text-muted no-underline transition hover:text-ink">View all</a>
    </div>
    <div class="grid gap-3 sm:grid-cols-3">
      {song.relatedSongs.map((related) => (
        <a href={`${base}songs/${related.slug}/`} class="rounded-lg border border-white/10 bg-white/[0.04] p-4 no-underline transition hover:border-peach/35 hover:bg-white/[0.07]">
          <p class="font-semibold">{related.title}</p>
          <p class="mt-1 text-sm text-muted">{related.album}</p>
        </a>
      ))}
    </div>
  </section>

  <dialog class="m-auto w-[min(42rem,calc(100vw-2rem))] rounded-lg border border-white/12 bg-[#171a20] p-0 text-ink shadow-2xl shadow-black/50 backdrop:bg-black/70" data-story-dialog>
    <div class="flex items-center justify-between gap-4 border-b border-white/10 p-5">
      <h2 class="text-lg font-semibold">{song.story.title}</h2>
      <button type="button" class="grid size-9 place-items-center rounded-full text-muted transition hover:bg-white/8 hover:text-ink" aria-label="Close story" onclick="document.querySelector('[data-story-dialog]')?.close()">
        <X size={19} />
      </button>
    </div>
    <div class="max-h-[70vh] overflow-auto p-5">
      <p class="text-sm leading-7 text-ink/82">{song.story.body}</p>
    </div>
  </dialog>
</article>

<script is:inline>
  const meaningLyric = document.querySelector("[data-meaning-lyric]");
  const meaningBody = document.querySelector("[data-meaning-body]");

  window.setLyricMeaningFromLine = (line) => {
    const lyric = line.getAttribute("data-annotation-lyric");
    const body = line.getAttribute("data-annotation-body");
    if (!lyric || !body || !meaningLyric || !meaningBody) return;

    meaningLyric.textContent = lyric;
    meaningBody.textContent = body;
  };

  const storyDialog = document.querySelector("[data-story-dialog]");

  storyDialog?.addEventListener("click", (event) => {
    if (event.target === storyDialog && storyDialog instanceof HTMLDialogElement) {
      storyDialog.close();
    }
  });
</script>
