---
import { ArrowRight } from "@lucide/astro";
import { getCollection } from "astro:content";
import { useT, localizedPath } from "../lib/i18n";

const locale = Astro.currentLocale ?? "en";
const t = useT(locale);
const songs = await getCollection("songs");
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const featured = songs.find((song) => song.data.slug === "nightlight") ?? songs[0];

const songUrl = (slug: string) => `${base}${localizedPath(locale, `/songs/${slug}/`).replace(/^\//, "")}`;
const coverUrl = (cover: string) => `${base}${cover.replace(/^\//, "")}`;
---

<section class="mx-auto grid max-w-7xl gap-8 px-4 py-8 sm:px-6 lg:grid-cols-[minmax(0,1fr)_26rem] lg:px-10 lg:py-12">
  <div class="min-w-0">
    <p class="mb-3 text-xs font-semibold uppercase tracking-[0.12em] text-peach">{t("home.eyebrow")}</p>
    <h1 class="max-w-3xl text-4xl font-bold tracking-normal sm:text-6xl">{t("home.heading")}</h1>
    <p class="mt-5 max-w-2xl text-base leading-7 text-muted">{t("home.tagline")}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={songUrl(featured.data.slug)} class="inline-flex h-11 items-center gap-2 rounded-lg bg-peach px-5 text-sm font-bold text-[#251211] no-underline transition hover:bg-peach-strong">
        {t("home.exploreCta", { title: featured.data.title })}
        <ArrowRight size={17} />
      </a>
    </div>
  </div>

  <a href={songUrl(featured.data.slug)} class="group block rounded-lg border border-white/10 bg-white/[0.045] p-4 no-underline shadow-2xl shadow-black/25 transition hover:border-peach/35 hover:bg-white/[0.07]">
    <img src={coverUrl(featured.data.coverImage)} alt={`${featured.data.title} cover art`} class="aspect-square w-full rounded-md object-cover" />
    <p class="mt-4 text-xs font-semibold uppercase tracking-[0.12em] text-muted">{t("home.featuredSong")}</p>
    <h2 class="mt-1 text-2xl font-bold">{featured.data.title}</h2>
    <p class="mt-1 text-sm text-muted">{featured.data.album}</p>
  </a>
</section>

<section class="mx-auto max-w-7xl px-4 pb-10 sm:px-6 lg:px-10">
  <h2 class="mb-4 text-lg font-semibold">{t("home.songsHeading")}</h2>
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {songs.map((song) => (
      <a href={songUrl(song.data.slug)} class="group block no-underline">
        <img src={coverUrl(song.data.coverImage)} alt={`${song.data.title} cover art`} class="aspect-square w-full rounded-md border border-white/10 object-cover transition group-hover:border-peach/35" />
        <p class="mt-3 text-base font-semibold">{song.data.title}</p>
        <p class="mt-0.5 text-sm text-muted">{song.data.artist}</p>
        <p class="text-sm text-muted">{song.data.album}</p>
      </a>
    ))}
  </div>
</section>
