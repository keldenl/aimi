{
  "name": "aimi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 PORTLESS_STATE_DIR=.portless portless",
    "dev:astro": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site dist",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check"
  },
  "portless": {
    "name": "aimi",
    "script": "dev:astro"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-tc": "^5.2.10",
    "@lucide/astro": "^1.17.0",
    "@tailwindcss/vite": "latest",
    "astro": "latest",
    "motion": "^12.40.0",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "pagefind": "latest",
    "portless": "^0.14.0",
    "typescript": "latest",
    "vite": "^7.3.5"
  }
}
